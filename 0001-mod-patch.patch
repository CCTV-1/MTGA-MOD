diff --git a/Wotc.Mtga.Cards.Text/Utilities.cs b/Wotc.Mtga.Cards.Text/Utilities.cs
new file mode 100644
index 0000000..26ed898
--- /dev/null
+++ b/Wotc.Mtga.Cards.Text/Utilities.cs
@@ -0,0 +1,176 @@
+using System.Collections.Generic;
+using System.IO;
+using System.Text.RegularExpressions;
+using GreClient.CardData;
+using Wotc.Mtga.Extensions;
+using Wotc.Mtga.Loc;
+
+namespace Wotc.Mtga.Cards.Text
+{
+	public static class Utilities
+	{
+		public static string AddLineBreaksToBulletPoints(string s)
+		{
+			string text = s.Replace("•", Constants.NEWLINE_BULLET_STR);
+			if (Languages.CurrentLanguage == "ja-JP")
+			{
+				text = text.Replace("• ", "•");
+			}
+			return text;
+		}
+
+		public static string AddLineBreaksToSpreeEntries(string s)
+		{
+			return s.Replace("+ ", Constants.NEWLINE_SPREE_STR);
+		}
+
+		public static string SanitizeParentheticalText(string rulesText)
+		{
+			if (!string.IsNullOrEmpty(rulesText))
+			{
+				string text = getRegexMatch(Constants.ABILITY_PARENTHETICAL_REGEX, rulesText);
+				string text2 = getRegexMatch(Constants.ABILITY_BEFORE_PARENTHESES_REGEX, rulesText);
+				if (!string.IsNullOrEmpty(text) && !string.IsNullOrEmpty(text2))
+				{
+					text = text.Trim();
+					text2 = text2.Trim();
+					if (text.Contains(text2, caseIndependent: true))
+					{
+						return text;
+					}
+				}
+			}
+			return rulesText;
+			static string getRegexMatch(Regex pattern, string input)
+			{
+				Match match = pattern.Match(input);
+				if (match.Success)
+				{
+					if (match.Groups.Count > 0)
+					{
+						return match.Groups[match.Groups.Count - 1].ToString();
+					}
+					return match.Value;
+				}
+				return input;
+			}
+		}
+
+		public static string GetBoldedAbilityText(string localizedText)
+		{
+			return localizedText;
+		}
+
+		public static bool TryStripLoyaltyPrefixFromString(ref string localizedText)
+		{
+			int num = -1;
+			for (int i = 0; i < 6 && i < localizedText.Length; i++)
+			{
+				if (((IReadOnlyCollection<char>)(object)Constants.COLON_CHARS).Contains(localizedText[i]))
+				{
+					num = i;
+					break;
+				}
+				if (!char.IsWhiteSpace(localizedText[i]) && !char.IsNumber(localizedText[i]) && !((IReadOnlyCollection<char>)(object)Constants.X_CHARS).Contains(localizedText[i]) && !((IReadOnlyCollection<char>)(object)Constants.PLUS_CHARS).Contains(localizedText[i]) && !((IReadOnlyCollection<char>)(object)Constants.MINUS_CHARS).Contains(localizedText[i]))
+				{
+					break;
+				}
+			}
+			if (num > 0)
+			{
+				localizedText = localizedText.Substring(num + 1);
+				localizedText = SanitizeParentheticalText(localizedText);
+				localizedText = localizedText.Trim();
+				return true;
+			}
+			return false;
+		}
+
+		public static bool TryStripChapterPrefixFromString(ref string localizedText)
+		{
+			int num = -1;
+			for (int i = 0; i < 6 && i < localizedText.Length; i++)
+			{
+				if (((IReadOnlyCollection<char>)(object)Constants.DASH_CHARS).Contains(localizedText[i]))
+				{
+					num = i;
+					break;
+				}
+				if (localizedText[i] != 'I' && localizedText[i] != 'V' && !char.IsWhiteSpace(localizedText[i]))
+				{
+					break;
+				}
+			}
+			if (num > 0)
+			{
+				localizedText = localizedText.Substring(num + 1);
+				if (localizedText[0] == '<')
+				{
+					localizedText = localizedText.Remove(0, localizedText.IndexOf('>') + 1);
+				}
+				localizedText = localizedText.Trim();
+				return true;
+			}
+			return false;
+		}
+
+		public static string RemoveHiragana(string cardTitle)
+		{
+			return new Regex("(（\\w+）)").Replace(cardTitle, "");
+		}
+
+		public static StringBackedInt GetLoyaltyAbilityCostFromLocalizedText(string englishLocalizedText)
+		{
+			StringBackedInt result = StringBackedInt.UNDEFINED;
+			int num = englishLocalizedText.IndexOfAny(Constants.COLON_CHARS);
+			if (num > 0 && num < 6)
+			{
+				string text = englishLocalizedText.Remove(num).Trim(' ', '[', ']');
+				result = new StringBackedInt(text);
+			}
+			if (string.IsNullOrWhiteSpace(result.RawText))
+			{
+				throw new InvalidDataException("Localized text was used as a Loyalty ability localization but did not have a valid cost!\n\"" + englishLocalizedText + "\"");
+			}
+			return result;
+		}
+
+		public static string SanitizeText(string text)
+		{
+			text = text.Replace("&#0D&#0A", "\n");
+			text = text.Replace("{1/2}", "½");
+			text = text.Replace("CHAINED ", string.Empty);
+			foreach (Match item in GreClient.CardData.Constants.MANA_MATCHER_FOR_CAPITALIZATION.Matches(text))
+			{
+				if (item.Groups.Count >= 2)
+				{
+					Group group = item.Groups[1];
+					text = text.Remove(group.Index, group.Length);
+					text = text.Insert(group.Index, group.Value.ToUpper());
+				}
+			}
+			foreach (object item2 in GreClient.CardData.Constants.MANA_MATCHER_FOR_SPACE_REPLACEMENT.Matches(text))
+			{
+				text = text.Replace(item2.ToString(), item2.ToString().Replace(" ", string.Empty));
+			}
+			return text;
+		}
+
+		public static string SanitizeArtistCreditText(string text)
+		{
+			text = text.Replace("{1/2}", "½");
+			return text;
+		}
+
+		public static string SanitizeAbilityText(string text)
+		{
+			Match match = new Regex("\\ \\(([^)]*)\\)$").Match(text);
+			if (match.Success)
+			{
+				Group group = match.Groups[0];
+				text = text.Remove(group.Index, group.Length);
+			}
+			return text;
+		}
+	}
+}
