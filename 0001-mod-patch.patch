+			if (instance.ObjectSourceGrpId > 11)
+			{
+				AbilityPrintingData abilityPrintingById2 = abilityDataProvider.GetAbilityPrintingById(instance.ObjectSourceGrpId);
+				if (abilityPrintingById2 != null)
+				{
+					return abilityPrintingById2;
+				}
+			}
+			if (instance.ExamineSourceId != 0 && gameState != null)
+			{
+				foreach (DelayedTriggerData delayedTriggerAffectee in gameState.DelayedTriggerAffectees)
+				{
+					if (delayedTriggerAffectee.AffectorId == instance.ExamineSourceId)
+					{
+						AbilityPrintingData abilityPrintingById3 = abilityDataProvider.GetAbilityPrintingById(delayedTriggerAffectee.AbilityId);
+						if (abilityPrintingById3 != null)
