+		public static bool TryExtractRollTableFromAbility(string abilityText, out string preambleAbilityText, out RollTableEntry[] rollTable)
+		{
+			preambleAbilityText = null;
+			rollTable = null;
+			MatchCollection matchCollection = Constants.DIE_ROLL_ENTRY_MATCH.Matches(abilityText);
+			if (matchCollection.Count < 2)
+			{
+				return false;
+			}
+			rollTable = new RollTableEntry[matchCollection.Count];
+			for (int i = 0; i < matchCollection.Count; i++)
+			{
+				Match match = matchCollection[i];
+				string[] array = Constants.DIE_ROLL_RANGE_MATCH.Match(match.Groups[1].Value).Groups[1].Value.Split('-', '–', '－');
+				uint num = 0u;
+				uint max = 0u;
+				for (int j = 0; j < array.Length; j++)
+				{
+					uint num2 = 0u;
+					bool flag = true;
+					for (int num3 = array[j].Length - 1; num3 >= 0; num3--)
+					{
+						char c = array[j][num3];
+						if (c != '+' && c != '＋')
+						{
+							int num4 = array[j].Length - 1 - num3 - ((!flag) ? 1 : 0);
+							num2 += (uint)char.GetNumericValue(c) * (uint)Math.Pow(10.0, num4);
+						}
+						else
+						{
+							flag = false;
+						}
+					}
+					if (j == 0)
+					{
+						num = num2;
+						max = (flag ? num : uint.MaxValue);
+					}
+					else
+					{
+						max = (flag ? num2 : uint.MaxValue);
+					}
+				}
+				string value = match.Groups[0].Value;
+				rollTable[i] = new RollTableEntry
+				{
+					Min = num,
+					Max = max,
+					RangeText = match.Groups[1].Value,
+					EffectText = match.Groups[2].Value,
+					FormattedText = value
+				};
+			}
+			preambleAbilityText = abilityText.Remove(abilityText.IndexOf(rollTable[0].RangeText, StringComparison.Ordinal)).Trim();
+			return true;
+		}
