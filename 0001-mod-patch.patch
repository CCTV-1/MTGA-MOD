+			if (instance.Colors.Count == 0 && printing.Colors.Count == 0 && !IsForcedColorless(instance, printing))
+			{
+				if (UsePredictiveManaColorsAsFrameColors(instance, printing))
+				{
+					List<CardColor> list = new List<CardColor>();
+					foreach (ManaColor predictiveActionManaColor in GetPredictiveActionManaColors(instance))
+					{
