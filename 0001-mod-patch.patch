diff --git a/GreClient.CardData/CardUtilities.cs b/GreClient.CardData/CardUtilities.cs
new file mode 100644
index 0000000..449d7e2
--- /dev/null
+++ b/GreClient.CardData/CardUtilities.cs
@@ -0,0 +1,873 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Text.RegularExpressions;
+using GreClient.Rules;
+using Wotc.Mtga.Cards.Database;
+using Wotc.Mtga.Extensions;
+using Wotc.Mtgo.Gre.External.Messaging;
+
+namespace GreClient.CardData
+{
+	public static class CardUtilities
+	{
+		public struct RollTableEntry
+		{
+			public uint Min;
+
+			public uint Max;
+
+			public string RangeText;
+
+			public string EffectText;
+
+			public string FormattedText;
+
+			public RollTableEntry(RollTableEntry other)
+			{
+				Min = other.Min;
+				Max = other.Max;
+				RangeText = other.RangeText;
+				EffectText = other.EffectText;
+				FormattedText = other.FormattedText;
+			}
+		}
+
+		public static List<uint> NonCraftableCardList = new List<uint>();
+
+		public static List<uint> NonCollectibleCardList = new List<uint>();
+
+		public static List<string> UnreleasedSets = new List<string>();
+
+		private static IComparer<CardColor> _wubrgComparer = new WUBRGColorComparer();
+
+		private static IComparer<CardColor> _dualColorComparer = new DualColorComparer();
+
+		public static bool IsMDFCCard(ICardDataAdapter model)
+		{
+			if (model == null)
+			{
+				return false;
+			}
+			if (model.ObjectType == GameObjectType.GameObjectType_Ability)
+			{
+				return false;
+			}
+			if (model.LinkedFaceType != LinkedFace.LinkedFace_MDFC_Front && model.LinkedFaceType != LinkedFace.LinkedFace_MDFC_Back)
+			{
+				return false;
+			}
+			return model.LinkedFacePrintings.Count == 1;
+		}
+
+		public static bool IsPrototypeParent(this ICardDataAdapter card)
+		{
+			if (card == null)
+			{
+				return false;
+			}
+			if (card.LinkedFaceType == LinkedFace.LinkedFace_PrototypeChild)
+			{
+				return card.LinkedFacePrintings.Count == 1;
+			}
+			return false;
+		}
+
+		public static bool IsPrototypeChild(this ICardDataAdapter card)
+		{
+			if (card == null)
+			{
+				return false;
+			}
+			if (card.LinkedFaceType == LinkedFace.LinkedFace_PrototypeParent)
+			{
+				return card.LinkedFacePrintings.Count == 1;
+			}
+			return false;
+		}
+
+		public static bool IsWildcard(uint GrpId)
+		{
+			if (GrpId == 9 || GrpId == 8 || GrpId == 7 || GrpId == 6)
+			{
+				return true;
+			}
+			return false;
+		}
+
+		public static bool IsSplitCard(ICardDataAdapter model, bool ignoreInstances = false)
+		{
+			if (model == null)
+			{
+				return false;
+			}
+			if (model.LinkedFaceType != LinkedFace.LinkedFace_SplitHalf)
+			{
+				return false;
+			}
+			if (ignoreInstances || model.Instance == null || model.ObjectType == GameObjectType.GameObjectType_RevealedCard)
+			{
+				foreach (CardPrintingData linkedFacePrinting in model.LinkedFacePrintings)
+				{
+					if (linkedFacePrinting.LinkedFaceType != LinkedFace.LinkedFace_SplitCard)
+					{
+						return false;
+					}
+				}
+				return model.LinkedFacePrintings.Count == 2;
+			}
+			return model.Instance.IsSplitCard();
+		}
+
+		public static bool IsSplitHalf(ICardDataAdapter model, bool ignoreInstances = false)
+		{
+			if (model == null)
+			{
+				return false;
+			}
+			if (model.LinkedFaceType != LinkedFace.LinkedFace_SplitCard)
+			{
+				return false;
+			}
+			if (model.Instance == null)
+			{
+				return model.LinkedFacePrintings.Count == 1;
+			}
+			if (model.ObjectType != GameObjectType.GameObjectType_SplitLeft && model.ObjectType != GameObjectType.GameObjectType_SplitRight)
+			{
+				return false;
+			}
+			if (ignoreInstances)
+			{
+				return model.LinkedFacePrintings.Count == 1;
+			}
+			if (model.Instance.LinkedFaceInstances.Count != 1)
+			{
+				return false;
+			}
+			return model.Instance.Zone.Type == model.Instance.LinkedFaceInstances[0].Zone.Type;
+		}
+
+		public static bool IsAdventureCard(ICardDataAdapter model, bool ignoreInstances = false)
+		{
+			if (model == null)
+			{
+				return false;
+			}
+			if (model.LinkedFaceType != LinkedFace.LinkedFace_AdventureChild)
+			{
+				return false;
+			}
+			if (model.Instance == null)
+			{
+				return model.LinkedFacePrintings.Count == 1;
+			}
+			if (model.ObjectType == GameObjectType.GameObjectType_RevealedCard)
+			{
+				return model.LinkedFacePrintings.Count == 1;
+			}
+			if (model.ObjectType != GameObjectType.GameObjectType_Card && !IsTokenCopy(model))
+			{
+				return false;
+			}
+			if (ignoreInstances)
+			{
+				return model.LinkedFacePrintings.Count == 1;
+			}
+			if (model.Instance.LinkedFaceInstances.Count != 1)
+			{
+				return false;
+			}
+			return model.Instance.Zone.Type == model.Instance.LinkedFaceInstances[0].Zone.Type;
+		}
+
+		public static bool IsAdventureSubCard(ICardDataAdapter model, bool ignoreInstances = false)
+		{
+			if (model == null)
+			{
+				return false;
+			}
+			if (model.LinkedFaceType != LinkedFace.LinkedFace_AdventureParent)
+			{
+				return false;
+			}
+			if (model.Instance == null)
+			{
+				return model.LinkedFacePrintings.Count == 1;
+			}
+			if (model.ObjectType != GameObjectType.GameObjectType_Adventure && !IsTokenCopy(model))
+			{
+				return false;
+			}
+			if (!ignoreInstances)
+			{
+				MtgCardInstance parent = model.Parent;
+				if (parent == null || parent.ObjectType != GameObjectType.GameObjectType_RevealedCard)
+				{
+					if (model.Instance.LinkedFaceInstances.Count != 1)
+					{
+						return false;
+					}
+					return model.Instance.Zone.Type == model.Instance.LinkedFaceInstances[0].Zone.Type;
+				}
+			}
+			return model.LinkedFacePrintings.Count == 1;
+		}
+
+		public static GameObjectType LinkedFaceToObject(LinkedFace linkedFaceType, int faceIndex = 0, bool isAToken = false)
+		{
+			switch (linkedFaceType)
+			{
+			case LinkedFace.LinkedFace_SplitCard:
+				return GameObjectType.GameObjectType_SplitCard;
+			case LinkedFace.LinkedFace_SplitHalf:
+				if (faceIndex != 0)
+				{
+					return GameObjectType.GameObjectType_SplitRight;
+				}
+				return GameObjectType.GameObjectType_SplitLeft;
+			case LinkedFace.LinkedFace_AdventureParent:
+				return GameObjectType.GameObjectType_Card;
+			case LinkedFace.LinkedFace_AdventureChild:
+				return GameObjectType.GameObjectType_Adventure;
+			case LinkedFace.LinkedFace_PrototypeChild:
+				return GameObjectType.GameObjectType_PrototypeFacet;
+			case LinkedFace.LinkedFace_MDFC_Back:
+				return GameObjectType.GameObjectType_MDFCBack;
+			default:
+				if (isAToken)
+				{
+					return GameObjectType.GameObjectType_Token;
+				}
+				return GameObjectType.GameObjectType_Card;
+			}
+		}
+
+		private static bool IsTokenCopy(ICardDataAdapter cardData)
+		{
+			if (cardData == null)
+			{
+				return false;
+			}
+			MtgCardInstance instance = cardData.Instance;
+			if (instance == null)
+			{
+				return false;
+			}
+			if (instance.IsCopy || instance.IsObjectCopy)
+			{
+				return instance.ObjectType == GameObjectType.GameObjectType_Token;
+			}
+			return false;
+		}
+
+		public static ICardDataAdapter CreateAbilityModData(ICardDataAdapter model)
+		{
+			if (CanCreateModData(model))
+			{
+				MtgCardInstance parent = model.Parent;
+				CardPrintingData objectSourcePrinting = model.Instance.ObjectSourcePrinting;
+				ModCardDataWrapper wrappedData = ModCardDataWrapper.GetWrappedData(model);
+				if (parent != null)
+				{
+					while (!parent.IsCardOrToken() && parent.Parent != null)
+					{
+						parent = parent.Parent;
+					}
+					if (parent.IsCardOrToken())
+					{
+						wrappedData.SetParentOverride(parent);
+						return wrappedData;
+					}
+				}
+				else if (objectSourcePrinting != null)
+				{
+					wrappedData.SetSourcePrintingOverride(objectSourcePrinting);
+					return wrappedData;
+				}
+			}
+			return model;
+		}
