+		public static bool DoesInstanceDifferMeaningfullyFromPrinting(MtgCardInstance instance, CardPrintingData printing)
+		{
+			if (instance.IsObjectCopy)
+			{
+				return true;
+			}
+			if (instance.FaceDownState.IsFaceDown && instance.GrpId != printing.GrpId)
+			{
+				return true;
+			}
+			if (instance.ObjectType == GameObjectType.GameObjectType_Emblem)
+			{
+				if (instance.TitleId == printing.TitleId)
+				{
+					return !instance.Abilities.ContainSameIds(printing.Abilities);
+				}
+				return true;
+			}
+			if (instance.TitleId != printing.TitleId)
+			{
+				return true;
+			}
+			if (!instance.Power.Equals(printing.Power))
+			{
+				return true;
+			}
+			if (!instance.Toughness.Equals(printing.Toughness) && !instance.CardTypes.Contains(CardType.CardType_Planeswalker) && !instance.CardTypes.Contains(CardType.CardType_Battle))
+			{
+				return true;
+			}
+			if (instance.Counters.Count > 0)
+			{
+				return true;
+			}
+			if (!instance.CardTypes.ContainSame(printing.Types))
+			{
+				return true;
+			}
+			if (!instance.Subtypes.ContainSame(printing.Subtypes))
+			{
+				return true;
+			}
+			if (!instance.Supertypes.ContainSame(printing.Supertypes))
+			{
+				return true;
+			}
+			if (!instance.Abilities.ContainsId(151u))
+			{
+				if (!printing.IsToken && !instance.Colors.ContainSame(printing.Colors))
+				{
+					return true;
+				}
+				if (printing.IsToken && !instance.Colors.ContainSame(printing.FrameColors))
+				{
+					return true;
+				}
+			}
+			if (instance.MutationChildrenIds.Count > 0)
+			{
+				return true;
+			}
+			if (instance.AbilityAdders.Count > 0 || instance.AbilityRemovers.Count > 0 || instance.AbilityModifications.Count > 0)
+			{
+				return true;
+			}
+			if (!IsBasicLand(instance, printing) && !instance.CardTypes.Contains(CardType.CardType_Battle) && !instance.Abilities.ContainSameIds_ExHiddenAbilities(printing.Abilities))
+			{
+				return true;
+			}
+			if (instance.ClassLevel > 0)
+			{
+				return true;
+			}
+			return false;
+		}
