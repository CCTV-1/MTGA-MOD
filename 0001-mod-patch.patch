+			int num2 = 1;
+			bool flag = false;
+			float num3 = -0.9f;
+			for (int i = 0; i < text.Length; i++)
+			{
+				if (text[i] == '（')
+				{
+					flag = true;
+					int num4 = text.IndexOf('）', i);
+					num = Math.Max(1, num4 - i - 1);
+					text2 += "<size=SIZE_REPLACE%><font=Font_Hiragana_JP>".Replace("SIZE_REPLACE", Math.Min(100 / num, 30).ToString());
+					num2 = 1;
+				}
+				else if (text[i] == '）')
+				{
+					flag = false;
+					text2 += "</font></size>";
+					if (i != text.Length - 1)
+					{
+						text2 += Environment.NewLine;
+					}
+				}
+				else if (flag)
+				{
+					if (num == 1)
+					{
+						text2 += $"<voffset={num}em>{text[i]}</voffset>";
+						continue;
+					}
+					int num5 = num - num2;
+					text2 += $"<voffset={num5}em>{text[i]}</voffset>";
+					if (num5 >= 1)
+					{
+						text2 = text2 + "<space=" + num3.ToString(CultureInfo.InvariantCulture) + "em>";
+					}
+					num2++;
+				}
+				else
+				{
+					char c = text[i];
+					text2 += ((c == 'ー') ? '┃' : c);
+					int num6 = i + 1;
+					if (text.Length > num6 && text[num6] != '（')
+					{
+						text2 += Environment.NewLine;
+					}
+				}
+			}
+			if (string.IsNullOrEmpty(text2))
