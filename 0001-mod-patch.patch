diff --git a/AccountInformation.cs b/AccountInformation.cs
new file mode 100644
index 0000000..c23e917
--- /dev/null
+++ b/AccountInformation.cs
@@ -0,0 +1,102 @@
+using System;
+using System.Collections.Generic;
+using WAS;
+using Wizards.Platform.Sdk.Model;
+using Wotc.Mtga.Extensions;
+
+public class AccountInformation
+{
+	public string AccountID;
+
+	public string GameID;
+
+	public string DisplayName;
+
+	public string PersonaID;
+
+	public string AccessToken;
+
+	public string Email;
+
+	public string ExternalID;
+
+	public string Password;
+
+	public DateTime Expiration;
+
+	public Credentials Credentials;
+
+	public TokenState CredentialsState;
+
+	public string[] Roles = Array.Empty<string>();
+
+	public List<SocialIdentity> LinkedAccounts;
+
+	private const string ROLE_MYTHIC_ORANGE = "WotC_REP";
+
+	private const string ROLE_INVITATIONAL_QUALIFIED = "Challenger";
+
+	private const string ROLE_DEBUG = "MTGA_DEBUG";
+
+	private const string ROLE_DEMO = "MTGA_Demo";
+
+	private const string ROLE_MDN_ALPHA = "MDN_ALPHA";
+
+	private const string ROLE_WOTC_ACCESS = "WotC_ACCESS";
+
+	private const string ROLE_FEATURE_TOGGLE = "MTGA_FeatureToggle";
+
+	private const string ROLE_SOURCED_EPIC = "SOURCED_EPIC";
+
+	public AccountTypes AccountType
+	{
+		get
+		{
+			if (string.IsNullOrWhiteSpace(AccountID))
+			{
+				return AccountTypes.Social;
+			}
+			return AccountTypes.WAS;
+		}
+	}
+
+	public bool HasRole_FeatureToggle()
+	{
+		return Roles.Contains("MTGA_FeatureToggle", StringComparison.InvariantCultureIgnoreCase);
+	}
+
+	public bool HasRole_Demo()
+	{
+		return Roles.Contains("MTGA_Demo", StringComparison.InvariantCultureIgnoreCase);
+	}
+
+	public bool HasRole_MDNAlpha()
+	{
+		return Roles.Contains("MDN_ALPHA", StringComparison.InvariantCultureIgnoreCase);
+	}
+
+	public bool HasRole_MythicOrange()
+	{
+		return true;
+	}
+
+	public bool HasRole_Debugging()
+	{
+		return Roles.Contains("MTGA_DEBUG", StringComparison.InvariantCultureIgnoreCase);
+	}
+
+	public bool HasRole_WotCAccess()
+	{
+		return Roles.Contains("WotC_ACCESS", StringComparison.InvariantCultureIgnoreCase);
+	}
+
+	public bool HasRole_InvitationalQualified()
+	{
+		return Roles.Contains("Challenger", StringComparison.InvariantCultureIgnoreCase);
+	}
+
+	public bool HasRole_SourcedEpic()
+	{
+		return Roles.Contains("SOURCED_EPIC", StringComparison.InvariantCultureIgnoreCase);
+	}
+}
