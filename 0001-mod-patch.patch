+		public static string FormatComplexTitle(string text)
+		{
+			if (text.Contains("（"))
+			{
+				for (int i = 0; i < text.Length; i++)
+				{
+					if (text[i] == '（')
+					{
+						int num = text.IndexOf('）', i);
+						int num2 = num - i - 1;
+						string text2 = "<space=-0.7em><voffset=0.8em><size=SIZE_REPLACE%><font=Font_Hiragana_JP>".Replace("SIZE_REPLACE", Math.Min(100 / num2, 30).ToString());
+						text = new Regex(Regex.Escape("（")).Replace(text, text2, 1);
+						Regex regex = new Regex(Regex.Escape("）"));
+						string text3 = "</font></size></voffset><space=Xem>".Replace("X", ((num - i - 1 == 1) ? 0.6f : 0.3f).ToString());
+						text = regex.Replace(text, text3, 1);
+						i += text2.Length + (num - i - 2) + text3.Length;
+					}
+				}
+			}
