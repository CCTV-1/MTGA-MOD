diff --git a/ModManager.cs b/ModManager.cs
new file mode 100644
index 0000000..9edea5b
--- /dev/null
+++ b/ModManager.cs
@@ -0,0 +1,342 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Net.Http;
+using System.Text;
+using TMPro;
+using UnityEngine;
+using UnityEngine.Rendering;
+using static NPEController;
+
+#pragma warning disable CS0649
+
+public class ModManager
+{
+    private ModManager()
+    {
+    }
+
+    public static ModManager Instance
+    {
+        get
+        {
+            lock (lockObj)
+            {
+                if (instance == null)
+                {
+                    instance = new ModManager();
+                    if (instance.config == null)
+                    {
+                        try
+                        {
+                            string configContent = File.ReadAllText(configFilePath, Encoding.UTF8);
+                            instance.config = JsonUtility.FromJson<ModConfig>(configContent);
+
+                            if (instance.config.userSkillLevel > UserSkillLevel.top)
+                            {
+                                instance.config.userSkillLevel = UserSkillLevel.NONE;
+                            }
+                            if (instance.config.draftDeckColor > DraftDeckColor.WUBRG)
+                            {
+                                instance.config.draftDeckColor = DraftDeckColor.NONE;
+                            }
+                            if (instance.config.autoSelectPlayer > SelectPlayer.OPPONENT)
+                            {
+                                instance.config.autoSelectPlayer = SelectPlayer.INVALID;
+                            }
+
+                            if (instance.config.userSkillLevel != UserSkillLevel.NONE)
+                            {
+                                apiUri = string.Format("{0}&user_group={1}", new object[]
+                                {
+                                    apiUri,
+                                    instance.config.userSkillLevel.ToString("G")
+                                });
+                            }
+                            if (instance.config.draftDeckColor != DraftDeckColor.NONE)
+                            {
+                                apiUri = string.Format("{0}&colors={1}", new object[]
+                                {
+                                    apiUri,
+                                    instance.config.draftDeckColor.ToString("G")
+                                });
+                            }
+                        }
+                        catch (Exception)
+                        {
+                            instance.config = new ModConfig();
+                        }
+                    }
+                }
+            }
+            return instance;
+        }
+    }
+
+    public Dictionary<string, DraftInfo> GetCardRankMap(string setCode, string draftType)
+    {
+        if (!this.config.displayIWDText)
+        {
+            return null;
+        }
+        if (!this.cardRankMap.TryGetValue(setCode + "_" + draftType, out Dictionary<string, DraftInfo> eventCardRankMap))
+        {
+            lock (lockObj)
+            {
+                bool exist = this.fetchingTask.ContainsKey(setCode + "_" + draftType);
+                if (!exist)
+                {
+                    this.fetchingTask[setCode + "_" + draftType] = true;
+                    this.FetchCardRankInfo(setCode, draftType);
+                }
+            }
+            return null;
+        }
+        return eventCardRankMap;
+    }
+
+    public async void FetchCardRankInfo(string setCode, string draftModeName)
+    {
+        string requestUrl = string.Format(apiUri, new object[]
+        {
+            setCode,
+            draftModeName,
+            startDate,
+            endDate
+        });
+
+        try
+        {
+            string responseBody = await this.client.GetStringAsync(requestUrl);
+            responseBody = string.Format("{{ \"data\": {0}}}", responseBody);
+            CardInfoList rankList = JsonUtility.FromJson<CardInfoList>(responseBody);
+            if (rankList != null)
+            {
+                Dictionary<string, DraftInfo> eventCardRankMap = new Dictionary<string, DraftInfo>();
+                foreach (CardInfo cardInfo in rankList.data)
+                {
+                    //discard untrusted data
+                    if ((cardInfo.ever_drawn_game_count >= this.config.maxUntrustedIWDDataAmount) || (cardInfo.never_drawn_game_count >= this.config.maxUntrustedIWDDataAmount))
+                    {
+                        double iwd = (cardInfo.ever_drawn_win_rate - cardInfo.never_drawn_win_rate) * 100.0;
+                        eventCardRankMap[cardInfo.name] = new DraftInfo(iwd, cardInfo.avg_pick);
+                    }
+                }
+                this.cardRankMap[setCode + "_" + draftModeName] = eventCardRankMap;
+            }
+        }
+        catch (HttpRequestException)
+        {
+            Debug.LogWarning("fetch " + setCode + "_" + draftModeName + "card rank info failure.");
+        }
+        lock (lockObj)
+        {
+            this.fetchingTask.Remove(setCode + "_" + draftModeName);
+        }
+    }
+
+    public string GetCardAvgPickInfo(string cardName)
+    {
+        string text = "";
+        foreach (KeyValuePair<string, Dictionary<string, DraftInfo>> keyValuePair in this.cardRankMap)
+        {
+            if (keyValuePair.Value != null && keyValuePair.Value.Count != 0)
+            {
+                if (keyValuePair.Value.TryGetValue(cardName, out DraftInfo draftInfo))
+                {
+                    text = string.Concat(new string[]
+                    {
+                        text,
+                        "\n",
+                        keyValuePair.Key,
+                        "平均抓位：",
+                        draftInfo.avgPick.ToString("F1")
+                });
+                }
+            }
+        }
+        return text;
+    }
+
+    public TMP_FontAsset ZhCNFont
+    {
+        get
+        {
+            if (this.modFont == null)
+            {
+                string fontFileName = this.config.fontName;
+                AssetBundle assetBundle = AssetBundle.LoadFromFile(Application.dataPath + "/" + fontFileName);
+                if (assetBundle == null)
+                {
+                    this.modFont = TMP_Settings.defaultFontAsset;
+                    Debug.LogWarning(string.Format("{0}/{1} don't exist,use game default font:\"{2}\".", new object[]{
+                        Application.dataPath,
+                        fontFileName,
+                        this.modFont.name
+                    }));
+                }
+                else
+                {
+                    this.modFont = assetBundle.LoadAsset<TMP_FontAsset>(fontFileName + " SDF");
+                }
+            }
+
+            return this.modFont;
+        }
+    }
+
+    public Material PopupMaterial
+    {
+        get
+        {
+            if (this.popupMaterial == null && this.modFont != null)
+            {
+                this.popupMaterial = new Material(this.modFont.material)
+                {
+                    name = this.modFont.material.name + " - popup",
+                    renderQueue = this.popupMaterialRenderQueue
+                };
+            }
+            return this.popupMaterial;
+        }
+    }
+
+    public ModConfig config;
+
+    private static ModManager instance = null;
+    private static readonly object lockObj = new object();
+    private static readonly string configFilePath = Application.dataPath + "/modconfig.json";
+    private static readonly string startDate = "2016-09-01";
+    private static readonly string endDate = DateTime.Now.ToString("yyyy-MM-dd");
+    private static string apiUri = "https://www.17lands.com/card_ratings/data?expansion={0}&format={1}&start_date={2}&end_date={3}";
+
+    private TMP_FontAsset modFont = null;
+    private Material popupMaterial = null;
+    private int popupMaterialRenderQueue = (int)RenderQueue.Transparent + 1;
+
+    // <eventName, <cardName, DraftInfo>>
+    private readonly Dictionary<string, Dictionary<string, DraftInfo>> cardRankMap = new Dictionary<string, Dictionary<string, DraftInfo>>();
+    private readonly Dictionary<string, bool> fetchingTask = new Dictionary<string, bool>();
+    private readonly HttpClient client = new HttpClient();
+
+    public enum UserSkillLevel : uint
+    {
+        NONE = 0,
+        bottom = 1,
+        middle = 2,
+        top = 3,
+    }
+
+    public enum DraftDeckColor : uint
+    {
+        NONE = 0,
+        W,
+        U,
+        B,
+        R,
+        G,
+        WU,
+        WB,
+        WR,
+        WG,
+        UB,
+        UR,
+        UG,
+        BR,
+        BG,
+        RG,
+        WUB,
+        WUR,
+        WUG,
+        WBR,
+        WBG,
+        WRG,
+        UBR,
+        UBG,
+        URG,
+        BRG,
+        WUBR,
+        WUBG,
+        WURG,
+        WBRG,
+        UBRG,
+        WUBRG
+    }
+
+    public enum SelectPlayer : uint
+    {
+        INVALID = 0,
+        SELF = 1,
+        OPPONENT = 2,
+    }
+
+    public struct DraftInfo
+    {
+        public DraftInfo(double iwdValue, double pickValue)
+        {
+            this.iwd = iwdValue;
+            this.avgPick = pickValue;
+        }
+
+        public double iwd;
+        public double avgPick;
+    }
+
+    [Serializable]
+    public class ModConfig
+    {
+        public string fontName = "sourcehansans-medium";
+
+        public string defaultFormatName = "Standard";
+
+        public bool displayIWDText = true;
+
+        public uint maxUntrustedIWDDataAmount = 200;
+
+        public UserSkillLevel userSkillLevel = UserSkillLevel.NONE;
+
+        public DraftDeckColor draftDeckColor = DraftDeckColor.NONE;
+
+        public bool alwayExportEnglishDeck = false;
+
+        public bool displayAbilityHangerExtraInfo = true;
+
+        public bool displayNetDeckFolders = true;
+
+        public SelectPlayer autoSelectPlayer = SelectPlayer.INVALID;
+    }
+
+    [Serializable]
+    private class CardInfo
+    {
+        public int seen_count;
+        public double avg_seen;
+        public int pick_count;
+        public double avg_pick;
+        public int game_count;
+        public int pool_count;
+        public double play_rate;
+        public double win_rate;
+        public int opening_hand_game_count;
+        public double opening_hand_win_rate;
+        public int drawn_game_count;
+        public double drawn_win_rate;
+        public int ever_drawn_game_count;
+        public double ever_drawn_win_rate;
+        public int never_drawn_game_count;
+        public double never_drawn_win_rate;
+        public double drawn_improvement_win_rate;
+        public string name;
+        public int mtga_id;
+        public string color;
+        public string rarity;
+        public string url;
+        public string url_back;
+    }
+
+    [Serializable]
+    private class CardInfoList
+    {
+        public List<CardInfo> data;
+    }
+}
